# ATLANTIS Environment Configuration
# Copy this file to .env and fill in your credentials.
# In DEMO mode, all services gracefully fall back to local/cached demonstration data.
# In LIVE mode, missing credentials display "AUTH REQUIRED" or honest fallback badges without crashing.

# 1. Copernicus Data Space Ecosystem (CDSE) - Sentinel-1 SAR Imagery
# Register at: https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
CDSE_USERNAME=
CDSE_PASSWORD=
CDSE_STAC_URL=https://catalogue.dataspace.copernicus.eu/stac
CDSE_ODATA_URL=https://catalogue.dataspace.copernicus.eu/odata/v1

# 2. Copernicus Climate Data Store (CDS / ERA5) - 10m Atmospheric Winds
# Register at: https://cds.climate.copernicus.eu/
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# 3. INCOIS (Indian National Centre for Ocean Information Services)
# Portal: https://incois.gov.in/
INCOIS_API_URL=https://incois.gov.in
INCOIS_OON_URL=https://incois.gov.in/site/datainfo/OON.jsp
INCOIS_ERDDAP_URL=https://erddap.incois.gov.in/erddap

# 4. AIS Maritime Feeds (VesselFinder / INCOIS / MarineCadastre)
# VesselFinder API Docs: https://www.vesselfinder.com/ais-api
VESSELFINDER_API_KEY=
VESSELFINDER_BASE_URL=https://api.vesselfinder.com
AIS_API_URL=

# 5. Copernicus Marine Service (CMEMS) - Hydrodynamic Surface Currents
# Register at: https://marine.copernicus.eu/
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=

# 6. LLM / AI Report Generation (Optional - falls back to structured forensic synthesis)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# 7. Operational Mode Configuration
APP_ENV=development
DATA_MODE=live  # Options: 'live' (queries external scientific feeds), 'demo' (deterministic offline)
DB_NAME=marineguard.db
SECRET_KEY=marineguard-ai-secret-key-change-in-production
